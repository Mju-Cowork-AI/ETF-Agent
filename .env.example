# 이 파일을 .env로 복사한 뒤 값을 채워 사용합니다. (.env는 커밋 금지)
# 실제 키는 Azure Key Vault에서 관리합니다. docs/dev-guide.md 참고.
LLM_API_KEY=
DATA_GO_KR_API_KEY=
DART_API_KEY=

# --- 아래는 팀 기획(docs/plan.md)에 따라 추가 ---
# 변수 이름은 FastAPI 기반 코드를 들여올 때 그 코드의 설정 이름에 맞춰 바꿉니다.
# Azure OpenAI (D2: 크레딧 범위 안)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# 배포 이름: 생성 / 검증(생성과 다른 모델) / 임베딩
AZURE_OPENAI_GENERATION_DEPLOYMENT=
AZURE_OPENAI_VERIFICATION_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# 예비 무료 모델 키 (장애 대비, 선택). 각자 자기 키를 씁니다.
GEMINI_API_KEY=
GROQ_API_KEY=
